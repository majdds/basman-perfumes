{
  "name": "basman-perfumes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Basman Perfumes (بسمان للعطور) — online storefront with cash-on-delivery ordering and an owner dashboard.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "start:local": "node scripts/start-local.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/dynamodb-local.mjs",
    "db:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-table.ts",
    "db:seed-demo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-admin.ts",
    "retention:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/run-retention.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@node-rs/argon2": "2.2.2",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-security": "4.2.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
