# ─────────────────────────────────────────────────────────────
# Basman Perfumes — environment configuration (placeholders only)
# Copy to .env.local for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# "development" | "production". Production enables HSTS and secure cookies.
APP_ENV=development

# Public base URL of the site (used for canonical URLs, sitemap, Open Graph).
SITE_URL=http://localhost:3000

# AWS region. Frankfurt (eu-central-1) is close to Palestine and supports every service used.
# On Amplify this is set automatically (AWS_* names are reserved) — only needed locally.
AWS_REGION=eu-central-1

# DynamoDB table name. Use different tables for dev / staging / production.
DYNAMODB_TABLE=basman-dev

# Local development only: point the SDK at DynamoDB Local. Leave EMPTY in AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Image storage driver: "local" (files under .data/uploads) or "s3".
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3:
S3_BUCKET=
# Public base URL for images (CloudFront distribution in front of the bucket), no trailing slash.
MEDIA_BASE_URL=

# Optional: e-mail new-order notifications through Amazon SES. Leave empty to disable.
# The core order system never depends on this.
SES_FROM_ADDRESS=
ORDER_NOTIFY_EMAIL=

# Trust the X-Forwarded-For header from the hosting proxy (true on Amplify/CloudFront).
TRUST_PROXY=false
